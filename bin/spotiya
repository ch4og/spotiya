#!/usr/bin/env python3
"""spotiya: launch the receiver terminal tools over ADB."""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import termios
import time
import tty

BASE = "/data/opt/spotify-connect"


def configured_device():
    explicit = os.environ.get("SPOTIYA_DEVICE") or os.environ.get("MINI2_DEVICE")
    if explicit:
        return explicit
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "spotiya" / "config.json"
    try:
        value = json.loads(config.read_text()).get("device")
        return value if isinstance(value, str) and value else None
    except (OSError, ValueError, AttributeError):
        return None


def select_device(parser, explicit):
    if explicit:
        return explicit
    result = subprocess.run(["adb", "devices"], text=True, capture_output=True)
    if result.returncode:
        parser.error(result.stderr.strip() or "adb devices failed")
    devices = [fields[0] for line in result.stdout.splitlines()
               if len(fields := line.split()) == 2 and fields[1] == "device"]
    if len(devices) == 1:
        return devices[0]
    parser.error("Choose an ADB device with --device or SPOTIYA_DEVICE; connected: " + (", ".join(devices) or "none"))


def main():
    parser = argparse.ArgumentParser(description="spotiya: terminal controls over ADB")
    parser.add_argument("--device", default=configured_device(), help="ADB serial/IP; otherwise configured or only connected device")
    parser.add_argument("command", nargs="?", default="tui", choices=(
        "tui", "addons", "addon", "airplay", "youtube", "login", "status", "play", "pause", "resume", "toggle", "next",
        "previous", "volume", "voice", "spectrum", "retry", "release", "start", "stop", "restart", "version", "profile", "profiles", "doctor", "update"))
    parser.add_argument("value", nargs="*")
    args = parser.parse_args()
    if args.command == "play":
        if not args.value:
            parser.error("play needs a song or artist")
        value = [" ".join(args.value)]
    elif args.command in ("volume", "voice", "spectrum", "airplay", "youtube"):
        if len(args.value) != 1:
            parser.error(args.command + " needs one value")
        value = args.value
    elif args.command == "addon":
        if len(args.value) == 2 and args.value[0] in ("install", "remove"):
            value = args.value[1:]
        elif len(args.value) == 4 and args.value[0] == "file":
            value = args.value[1:]
        else:
            parser.error("addon accepts: install ID, remove ID, or file ID REMOTE_ARCHIVE REMOTE_SHA256SUMS")
    elif args.command == "doctor":
        if not args.value:
            value = []
        elif args.value[0] == "report" and len(args.value) <= 2:
            value = [args.value[1] if len(args.value) == 2 else "-"]
        else:
            parser.error("doctor accepts: report [REMOTE_FILE]")
    elif args.command == "update":
        if not args.value:
            value = []
        elif args.value == ["check"]:
            value = []
        elif len(args.value) == 3 and args.value[0] == "file":
            value = args.value[1:]
        elif len(args.value) == 1:
            value = args.value
        else:
            parser.error("update accepts: check, VERSION, or file REMOTE_ARCHIVE REMOTE_SHA256SUMS")
    elif args.command == "profile":
        if not args.value:
            value = []
        elif len(args.value) == 2 and args.value[0] == "select":
            value = [args.value[1]]
        else:
            parser.error("profile accepts: select ID_OR_JSON")
    else:
        if args.value:
            parser.error("unexpected arguments")
        value = []
    adb = ["adb", "-s", select_device(parser, args.device)]
    if args.command in ("start", "stop", "restart"):
        os.execvp("adb", adb + ["shell", shlex.join(["/etc/init.d/S99spotify-connect", args.command])])
    interactive = args.command in ("tui", "addons")
    if interactive and not sys.stdin.isatty():
        parser.error(args.command + " needs an interactive terminal")
    if args.command not in ("status", "version", "profile", "profiles", "doctor", "update", "addon"):
        start = subprocess.run(adb + ["shell", shlex.join([BASE + "/start.sh"])], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if start.returncode or not any(s in start.stdout for s in ("already running", "Connect started")):
            sys.exit(start.stdout.strip() or "Unable to start receiver")
    remote_command = ("profile-select" if value else "profile-info") if args.command == "profile" else args.command
    if args.command == "doctor" and value:
        remote_command = "doctor-report"
    elif args.command == "update":
        remote_command = "update-file" if len(value) == 2 else ("update-tag" if value else ("update-check" if args.value else "update"))
    elif args.command == "addon":
        remote_command = "addon-install-file" if len(value) == 3 else "addon-" + args.value[0]
    elif args.command == "youtube" and value[0] not in ("on", "off"):
        # Anything but on/off is a link to play.
        remote_command = "youtube-url"
    remote = shlex.join([BASE + "/spotiya", "--" + remote_command] + value)
    if interactive:
        columns, rows = shutil.get_terminal_size(fallback=(80, 24))
        # adb does not forward the environment; truecolor support decides the TUI palette.
        colors = os.environ.get("COLORTERM", "")
        prefix = f"export COLORTERM={shlex.quote(colors)}; " if colors in ("truecolor", "24bit") else ""
        # The station clock runs in UTC; the TUI header shows the time here.
        prefix += f"export SPOTIYA_UTC_OFFSET={time.localtime().tm_gmtoff}; "
        remote = f"{prefix}stty rows {rows} cols {columns}; exec " + remote
    flags = ["-t"] if interactive else []
    if interactive:
        saved = termios.tcgetattr(sys.stdin)
        try:
            tty.setraw(sys.stdin)
            return subprocess.call(adb + ["shell"] + flags + [remote])
        finally:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
    os.execvp("adb", adb + ["shell"] + flags + [remote])


if __name__ == "__main__":
    sys.exit(main())
